# Android build artifacts
*.apk
*.aar
*.dex

# Android build outputs
build/
.externalNativeBuild/
.cxx/

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

