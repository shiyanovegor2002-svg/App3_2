<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestingAppAndroid2"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Сервис 1: Использование доступного на запись хранилища ключей (M9: Insecure Data Storage) -->
        <service
            android:name=".services.InsecureWriteStorageService"
            android:enabled="true"
            android:exported="true" />

        <!-- Сервис 2: Использование доступного на чтение хранилища с приватными ключами, защищёнными слабым паролем (M1: Improper Credential Usage) -->
        <service
            android:name=".services.WeakPasswordProtectedKeyService"
            android:enabled="true"
            android:exported="true" />

        <!-- Сервис 3: Использование доступного на чтение хранилища со слабым паролем и закрытыми ключами (M1: Improper Credential Usage) -->
        <service
            android:name=".services.PrivateKeyWeakPasswordService"
            android:enabled="true"
            android:exported="true" />

    </application>

</manifest>
